// IFJ26 extension test: FUNEXP + BOOLTHEN in one program (no CONTROL)
// Self-checking: every check prints 'ok   <name>' or 'FAIL <name> ...'.
// stdin: 4, 10, 20, hello, 1.25, true, false, true (one per line)
import ifj26.*

def checkInt(name: String, got: Int, want: Int): Unit =
  if got == want then
    print("ok   " + name + "\n")
  else
    print("FAIL " + name + " got=" + toStr(got) + " want=" + toStr(want) + "\n")

def checkStr(name: String, got: String, want: String): Unit =
  if got == want then
    print("ok   " + name + "\n")
  else
    print("FAIL " + name + " got=[" + got + "] want=[" + want + "]\n")

def checkDbl(name: String, got: Double, want: Double): Unit =
  checkStr(name, toStr(got), toStr(want))

def checkBool(name: String, got: Boolean, want: Boolean): Unit =
  if got == want then
    print("ok   " + name + "\n")
  else
    print("FAIL " + name + " got=" + toStr(got) + " want=" + toStr(want) + "\n")

def add(a: Int, b: Int): Int = a + b
def mul(a: Int, b: Int): Int = a * b

def t1(): Int =
  print("1")
  1

def t2(): Int =
  print("2")
  2

def t3(): Int =
  print("3")
  3

def sq(a: Int): Int = a * a
def three(): Int = 3
def half(x: Double): Double = x / 2
def avg(a: Double, b: Double): Double = (a + b) / 2
def toD(a: Int): Double = a
def twice(x: Int) = x + x
def greet(name: String): String = "hi " + name
def nop(): Unit = ()
def sumsq(a: Int, b: Int): Int = sq(a) + sq(b)
def viaLater(a: Int): Int = later(a) + 1
def later(a: Int): Int = a * 10
def one() = sq(1) + sumsq(1, 1)
def sub3(x: Int, y: Int, z: Int): Int = x - y - z

def add3(
    a: Int,
    b: Int,
    c: Int,
  ): Int =
    a + b + c

def fact(n: Int): Int =
  if n < 2 then
    return 1
  else
    return n * fact(n - 1)

def fib(n: Int): Int =
  if n < 2 then
    return n
  else
    return fib(n - 1) + fib(n - 2)

def isEven(n: Int): Int =
  if n == 0 then
    return 1
  else
    return isOdd(n - 1)

def isOdd(n: Int): Int =
  if n == 0 then
    return 0
  else
    return isEven(n - 1)

def sumTo(n: Int): Int =
  if n == 0 then
    return 0
  else
    return n + sumTo(n - 1)

def retCall(a: Int): Int =
  return add(a, 1) * add(a, 2)

def weird(a: Int): Int =
    var r = a
    if r > 0 then
       r = add(r, 1)
    else
       r = add(r, 2)
    return mul(r, 2)

def loopCount(limit: Int): Int =
  var i = 0
  while sq(i) < limit do
    i = i + 1
  i

def firstSqOver(limit: Int): Int =
  var i = 0
  while i < 100 do
    if sq(i) > limit then
      return i
    else
      ()
    i = i + 1
  return -1

def isPos(x: Int): Boolean = x > 0
def both(a: Boolean, b: Boolean): Boolean = a && b
def either(a: Boolean, b: Boolean): Boolean = a || b
def inv(a: Boolean): Boolean = !a

def sideT(): Boolean =
  print("T")
  true

def sideF(): Boolean =
  print("F")
  false

def cmpRet(a: Int, b: Int): Boolean =
  if a < b then
    return true
  else
    return false

def isEvenB(n: Int): Boolean =
  if n == 0 then
    return true
  else
    return isOddB(n - 1)

def isOddB(n: Int): Boolean =
  if n == 0 then
    return false
  else
    return isEvenB(n - 1)

def anyOver(limit: Int): Boolean =
  var i = 0
  while i < 10 do
    if i * i > limit then
      return true
    i = i + 1
  return false

def classify(x: Int): String =
  var r = "none"
  if x < 0 then
    r = "neg"
  else if x == 0 then
    r = "zero"
  else if x < 10 then
    r = "small"
  else
    r = "big"
  r

def classifyNoElse(x: Int): String =
  var r = "none"
  if x < 0 then
    r = "neg"
  else if x == 0 then
    r = "zero"
  r

def signB(x: Int): Unit =
  if x < 0 then
    print("-")
  else if x == 0 then
    print("0")
  else if x < 5 then
    print("+")

def maybePrint(x: Int): Unit =
  if x > 0 then
    print("pos")

def secFunexp(): Unit =
  print("== FUNEXP ==\n")
  // --- spec examples (stdin: 4, 10, 20, hello, 1.25) ---
  val result = 2 * fact(readInt() + 1)
  checkInt("spec1", result, 240)
  checkStr("spec2", toStr(result + strLength(subStr("abcd", 1, 3))), "242")
  // --- nested user calls ---
  checkInt("nest1", add(add(1, 2), add(3, 4)), 10)
  checkInt("nest2", add(add(add(1, 2), 3), 4), 10)
  checkInt("nest3", mul(add(1, 2), add(3, 4)), 21)
  checkInt("nest4", add(add(add(add(add(1, 1), 1), 1), 1), 1), 6)
  checkInt("nest5", twice(twice(twice(1))), 8)
  checkInt("nest6", add(mul(2, 3), add(sq(2), three())), 13)
  // --- precedence / associativity with calls ---
  checkInt("prec1", 2 + 3 * sq(4), 50)
  checkInt("prec2", -sq(3), -9)
  checkInt("prec3", sq(-3), 9)
  checkInt("prec4", sq(2 + 3), 25)
  checkInt("prec5", add(1, 2) * add(3, 4) - add(5, 6), 10)
  checkInt("prec6", 100 / add(2, 3) / 2, 10)
  checkInt("prec7", add(10, 3) / 4, 3)
  checkInt("prec8", add(-10, -3) / 4, -3)
  checkInt("prec9", add(1, 2) * add(3, 4) - mul(2, 3) / add(1, 1) + -sq(2) * (add(1, 0) + 1), 10)
  checkInt("prec10", 10 - add(1, 2) - add(3, 4), 0)
  checkInt("prec11", (add(1, 2) + 2) * 3, 15)
  checkInt("prec12", add(1, 2) - -add(1, 1), 5)
  // --- builtins inside expressions ---
  checkInt("bi1", strLength("hello") + strLength("ab"), 7)
  checkInt("bi2", ord("A", 0) + ord("B", 0), 131)
  checkStr("bi3", chr(ord("a", 0) + 1), "b")
  checkStr("bi4", subStr("hello world", 6, 11) + "!", "world!")
  checkStr("bi5", toStr(1 + 2) + toStr(3 * 4), "312")
  checkInt("bi6", toInt(2.5 * 4), 10)
  checkInt("bi7", toInt(half(9)), 4)
  checkStr("bi8", toStr(half(5) + 1), "3.50")
  checkInt("bi9", strLength(toStr(12345) + "x"), 6)
  checkInt("bi10", ord(subStr("xyz", 1, 2), 0), 121)
  checkStr("bi11", chr(65) + chr(66) + chr(67), "ABC")
  checkInt("bi12", strLength(greet("bob")), 6)
  checkInt("bi13", toInt(avg(3, 5)), 4)
  // --- Int -> Double widening of arguments and results ---
  checkDbl("wid1", half(3), 1.5)
  checkDbl("wid2", half(add(1, 2)), 1.5)
  checkDbl("wid3", half(2) + half(4), 3.0)
  checkDbl("wid4", avg(half(4), 4), 3.0)
  checkDbl("wid5", avg(1, 2) * 2, 3.0)
  checkStr("wid6", toStr(half(7)), "3.50")
  checkDbl("wid7", toD(add(1, 2)) + 0.5, 3.5)
  // --- evaluation order (left to right), the trace line is part of the expected output ---
  print("order1=")
  val o1 = t1() + t2() * t3()
  print("\n")
  checkInt("order1 value", o1, 7)
  print("order2=")
  val o2 = sub3(t3(), t2(), t1())
  print("\n")
  checkInt("order2 value", o2, 0)
  print("order3=")
  val o3 = add(t1(), add(t2(), t3()))
  print("\n")
  checkInt("order3 value", o3, 6)
  print("order4=")
  val o4 = mul(add(t1(), t2()), add(t3(), t1()))
  print("\n")
  checkInt("order4 value", o4, 12)
  print("order5=")
  if t1() < t2() then
    print("<")
  else
    print(">=")
  print("\n")
  // --- calls in conditions ---
  if fact(4) == 24 then
    print("ok   cond-if\n")
  else
    print("FAIL cond-if\n")
  checkInt("cond-while", loopCount(50), 8)
  var w = 0
  while add(w, 1) < 5 do
    w = w + 1
  checkInt("cond-while2", w, 4)
  // --- recursion inside expressions ---
  checkInt("rec1", fib(15), 610)
  checkInt("rec2", fact(10), 3628800)
  checkInt("rec3", fib(10) + fib(11), 144)
  checkInt("rec4", isEven(10) + isOdd(7), 2)
  checkInt("rec5", sumTo(100), 5050)
  checkInt("rec6", sumTo(add(50, 50)), 5050)
  checkInt("rec7", fact(fact(3)), 720)
  // --- return of call expressions, one-line bodies, inferred types, forward calls ---
  checkInt("ret1", retCall(3), 20)
  checkInt("ret2", weird(1), 4)
  checkInt("ret3", weird(-5), -6)
  checkInt("ret4", firstSqOver(50), 8)
  checkInt("ret5", firstSqOver(1000000), -1)
  checkInt("one1", sumsq(3, 4), 25)
  checkInt("one2", one(), 3)
  checkInt("fwd1", viaLater(5), 51)
  checkStr("str1", greet("a") + "|" + greet("b"), "hi a|hi b")
  checkStr("str2", greet(greet("x")), "hi hi x")
  // --- unary minus / parentheses / expressions as arguments ---
  checkInt("arg1", add(-1, -(2 + 3)), -6)
  checkInt("arg2", add((1), (2)), 3)
  checkInt("arg3", add(-add(1, 2), 10), 7)
  checkInt("arg4", add(1 + 2, 3 * 4), 15)
  checkStr("arg5", greet("a" + "b"), "hi ab")
  // --- Unit results of calls ---
  print("unit=")
  print(nop())
  print("|")
  print(toStr(nop()))
  print("\n")
  // --- calls as statements (result discarded), also with operators ---
  add(1, 2)
  add(1, 2) + 3
  fact(3) * fact(2)
  sq(2); sq(3)
  checkInt("stmt", 1, 1)
  // --- ';' separator with calls ---
  val a = add(1, 1); val b = add(a, a)
  checkInt("semi", b, 4)
  // --- calls spread over several lines (LF inside parentheses), trailing commas ---
  val ml = add(
      add(1, 2),
      mul(
          3,
          4,
          ),
      ) + 1
  checkInt("multi1", ml, 16)
  val ml2 = (add(1, 2)
      + mul(3, 4)
      + sq(2))
  checkInt("multi2", ml2, 19)
  checkInt("multi3", add3(add(1, 1), sq(2), three()), 9)
  // --- readers inside expressions ---
  checkInt("read1", readInt() + readInt() * 2, 50)
  checkInt("read2", strLength(readLine()), 6)
  checkStr("read3", toStr(readDouble() * 2), "2.50")
  print("== FUNEXP done ==\n")

def secBool(): Unit =
  print("== BOOLTHEN ==\n")
  // --- literals, storage, typed Boolean variables ---
  val t = true
  val f = false
  var flag = false
  val typed: Boolean = 3 < 4
  checkBool("lit1", t, true)
  checkBool("lit2", f, false)
  flag = true
  checkBool("var1", flag, true)
  flag = 1 > 2
  checkBool("var2", flag, false)
  checkBool("typed", typed, true)
  // --- relational expressions are Boolean values ---
  checkBool("rel1", 1 < 2, true)
  checkBool("rel2", 1 >= 2, false)
  checkBool("rel3", 2 <= 2, true)
  checkBool("rel4", 3 > 2, true)
  checkBool("rel5", 1 == 1, true)
  checkBool("rel6", 1 != 1, false)
  checkBool("rel7", "a" < "b", true)
  checkBool("rel8", "b" <= "a", false)
  checkBool("rel9", 1.5 > 1, true)
  checkBool("rel10", 2 == 2.0, true)
  checkBool("rel11", "abc" == "abc", true)
  checkBool("rel12", "abc" != "abd", true)
  checkBool("rel13", 2.5 != 2, true)
  // --- truth tables ---
  checkBool("and_tt", true && true, true)
  checkBool("and_tf", true && false, false)
  checkBool("and_ft", false && true, false)
  checkBool("and_ff", false && false, false)
  checkBool("or_tt", true || true, true)
  checkBool("or_tf", true || false, true)
  checkBool("or_ft", false || true, true)
  checkBool("or_ff", false || false, false)
  checkBool("not_t", !true, false)
  checkBool("not_f", !false, true)
  checkBool("not_not", !(!true), true)
  checkBool("not_var", !t, false)
  // --- precedence: ! > relational > && > || ---
  checkBool("prec1", true || false && false, true)
  checkBool("prec2", (true || false) && false, false)
  checkBool("prec3", !false && false, false)
  checkBool("prec4", !(false && false), true)
  checkBool("prec5", 1 < 2 && 2 < 3, true)
  checkBool("prec6", 1 > 2 || 2 > 1, true)
  checkBool("prec7", 1 + 1 == 2 && 2 * 2 == 4, true)
  checkBool("prec8", !(1 == 1) || 2 == 2, true)
  checkBool("prec9", 1 < 2 == true, true)
  checkBool("prec10", !true == false, true)
  checkBool("prec11", !false != false, true)
  checkBool("prec12", false && false || true, true)
  checkBool("prec13", true || true && false, true)
  checkBool("prec14", !(1 < 2) || 3 < 4 && 5 < 6, true)
  checkBool("prec15", false || false || true, true)
  checkBool("prec16", true && true && false, false)
  checkBool("prec17", 1 + 2 * 3 == 7 && 10 / 3 == 3, true)
  checkBool("prec18", -1 < 0 && -(-1) > 0, true)
  checkBool("prec19", 1.0 < 2 && 2 < 3.5, true)
  // --- short-circuit evaluation, the trace line is part of the expected output ---
  print("sc=")
  val s1 = false && sideT()
  print("|")
  val s2 = true || sideT()
  print("|")
  val s3 = true && sideT()
  print("|")
  val s4 = false || sideT()
  print("|")
  val s5 = sideF() || sideF() || sideT()
  print("|")
  val s6 = sideF() && sideT() && sideT()
  print("|")
  val s7 = true || sideT() && sideT()
  print("|")
  val s8 = (sideT() || sideF()) && sideT()
  print("\n")
  checkBool("sc1", s1, false)
  checkBool("sc2", s2, true)
  checkBool("sc3", s3, true)
  checkBool("sc4", s4, true)
  checkBool("sc5", s5, true)
  checkBool("sc6", s6, false)
  checkBool("sc7", s7, true)
  checkBool("sc8", s8, true)
  print("sc-if=")
  if false && sideT() then
    print("X")
  else
    print("e")
  if true || sideT() then
    print("y")
  else
    print("X")
  print("\n")
  val zero = 0
  checkBool("sc-div1", zero != 0 && 10 / zero > 1, false)
  checkBool("sc-div2", zero == 0 || 10 / zero > 1, true)
  // --- Boolean parameters and results ---
  checkBool("fn1", isPos(3), true)
  checkBool("fn2", isPos(-3), false)
  checkBool("fn3", both(isPos(1), isPos(2)), true)
  checkBool("fn4", both(isPos(1), isPos(-2)), false)
  checkBool("fn5", either(isPos(-1), isPos(2)), true)
  checkBool("fn6", inv(isPos(5)), false)
  checkBool("fn7", inv(inv(t)), true)
  checkBool("fn8", cmpRet(1, 2), true)
  checkBool("fn9", cmpRet(2, 1), false)
  checkBool("fn10", isEvenB(10), true)
  checkBool("fn11", isOddB(10), false)
  checkBool("fn12", isEvenB(7) || isOddB(7), true)
  checkBool("fn13", isPos(1) && !isPos(-1) && cmpRet(1, 2), true)
  checkBool("fn14", both(1 < 2, "a" < "b"), true)
  checkBool("fn15", anyOver(50), true)
  checkBool("fn16", anyOver(100), false)
  // --- == and != on Boolean values ---
  checkBool("eq1", true == true, true)
  checkBool("eq2", true != false, true)
  checkBool("eq3", (1 < 2) == (3 < 4), true)
  checkBool("eq4", isPos(1) == isPos(2), true)
  checkBool("eq5", isPos(1) != isPos(-1), true)
  checkBool("eq6", false == (1 > 2), true)
  checkBool("eq7", t == f, false)
  checkBool("eq8", (t && f) == f, true)
  // --- toStr / print of Boolean ---
  checkStr("str1", toStr(true), "true")
  checkStr("str2", toStr(false), "false")
  checkStr("str3", toStr(1 < 2), "true")
  checkStr("str4", toStr(isPos(-1)), "false")
  checkStr("str5", toStr(t && !f), "true")
  checkStr("str6", "v=" + toStr(f || t), "v=true")
  print("print=")
  print(true)
  print("|")
  print(false)
  print("|")
  print(1 < 2)
  print("|")
  print(isPos(-1))
  print("\n")
  // --- arbitrary Boolean expressions as conditions ---
  var cnt = 0
  val ca = true
  val cb = false
  val cc = true
  if ca && !cb || cc then
    cnt = cnt + 1
  else
    cnt = cnt + 100
  if !ca then
    cnt = cnt + 100
  else
    cnt = cnt + 10
  if isPos(1) && isPos(2) then
    cnt = cnt + 1000
  else
    cnt = cnt + 100000
  checkInt("cond1", cnt, 1011)
  var done = false
  var k = 0
  while !done do
    k = k + 1
    if k >= 5 then
      done = true
  checkInt("while1", k, 5)
  var m = 0
  var stop = false
  while m < 100 && !stop do
    m = m + 7
    if m > 30 then
      stop = true
  checkInt("while2", m, 35)
  var n = 10
  while n > 0 && isPos(n) do
    n = n - 3
  checkInt("while3", n, -2)
  var tog = false
  var tc = 0
  while tc < 5 do
    tog = !tog
    tc = tc + 1
  checkBool("toggle", tog, true)
  // --- if without else, else-if chains ---
  var sh = 0
  if sh == 0 then
    sh = 1
  if sh == 0 then
    sh = 100
  checkInt("short1", sh, 1)
  checkStr("elif1", classify(-5), "neg")
  checkStr("elif2", classify(0), "zero")
  checkStr("elif3", classify(7), "small")
  checkStr("elif4", classify(50), "big")
  checkStr("elif5", classifyNoElse(-1), "neg")
  checkStr("elif6", classifyNoElse(0), "zero")
  checkStr("elif7", classifyNoElse(5), "none")
  print("sign=")
  signB(-3)
  signB(0)
  signB(3)
  signB(30)
  print("|")
  maybePrint(5)
  maybePrint(-5)
  print("\n")
  var deep = 0
  if ca then
    if cb then
      deep = 1
    else if cc then
      deep = 2
    else
      deep = 3
  else
    deep = 4
  checkInt("nested1", deep, 2)
  // --- readBoolean (stdin: true, false, true) ---
  val rb1 = readBoolean()
  val rb2 = readBoolean()
  checkBool("rb1", rb1, true)
  checkBool("rb2", rb2, false)
  checkBool("rb3", rb1 && !rb2, true)
  checkBool("rb4", readBoolean() || false, true)
  print("== BOOLTHEN done ==\n")

def runAllSections(): Unit =
  secFunexp()
  secBool()

@main
def runAll(): Unit =
  runAllSections()